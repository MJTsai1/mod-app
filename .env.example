# Copy this file to .env.local for local development.
# In Vercel, set these under Project Settings -> Environment Variables instead.
# NEVER commit a file containing real values.

# --- Supabase (required) ------------------------------------------------
# Project Settings -> API in your Supabase dashboard.

# Public — safe to expose to the browser. Subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. Bypasses Row Level Security. Never expose this
# to the browser or commit it to source control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- App -------------------------------------------------------------------

# Public base URL of the deployed site (used to build links in Discord
# notifications, and OTP email redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server-side only. Random string used to hash submitter IP
# addresses for rate limiting (never stores the raw IP). Generate with:
#   openssl rand -hex 32
IP_HASH_SECRET=replace-with-a-long-random-string

# --- Cloudflare Turnstile (optional, recommended) ---------------------------
# Leave unset to disable CAPTCHA verification on the application form.
# https://dash.cloudflare.com/?to=/:account/turnstile

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Discord integration (optional) -----------------------------------------
# Leave unset to disable. When set, a new-application notification embed is
# posted to this webhook. SECRET — server-side only, never sent to the browser.
# Create one via Server Settings -> Integrations -> Webhooks in Discord.

DISCORD_WEBHOOK_URL=
